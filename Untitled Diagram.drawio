        <mxCell id="X61RnXW4YofN9kBGOQYU-57" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.maintenance_windows;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;Core host - aggregates the online data.&amp;nbsp;&lt;/div&gt;&lt;div&gt;The top bar data like wind power,&amp;nbsp;&lt;/div&gt;&lt;div&gt;active power, reactive power,&amp;nbsp;&lt;/div&gt;&lt;div&gt;Status of different turbines&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
